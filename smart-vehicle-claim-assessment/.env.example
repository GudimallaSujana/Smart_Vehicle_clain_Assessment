SVC_ENV=development
SVC_DEMO_MODE=true
SVC_DB_PATH=outputs/app.sqlite3
SVC_STORAGE_DIR=outputs
SVC_DATA_DIR=data
SVC_CONFIG_DIR=configs
SVC_MODEL_DIR=models
SVC_YOLO_WEIGHTS=
SVC_OCR_ENGINE=auto
SVC_MAX_IMAGE_MB=10
SVC_MAX_DOCUMENT_MB=15
SVC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SVC_LOG_LEVEL=INFO
